# =============================================================================
# Dockerfile.dashboard — Streamlit Dashboard
# =============================================================================
# Separate image for the dashboard so it can be run independently or together with the API

FROM python:3.11-slim-bookworm

WORKDIR /app

# Install only dashboard dependencies
RUN pip install --no-cache-dir \
    streamlit==1.39.0 \
    plotly==5.24.1 \
    requests==2.32.3 \
    pandas==2.2.0 \
    pyarrow==13.0.0 \
    rpds==0.8.0 \
    python-dotenv==1.0.1

# Copy dashboard files only
COPY dashboard/ ./dashboard/

# Use non-root user for security
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --no-create-home --shell /bin/false appuser
USER appuser

EXPOSE 8501

# Run Streamlit on all interfaces so it is accessible outside the container
CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]