# Predictive Maintenance project environment variables

# Database URL (SQLite dev default, use PostgreSQL in prod)
# For development (SQLite):
DATABASE_URL=sqlite:///data/predictive_maintenance.db

# PostgreSQL credentials (for Docker Compose)
POSTGRES_DB=pdm_db
POSTGRES_USER=pdm_user
POSTGRES_PASSWORD=pdm_pass

# Model artifact paths (can override defaults)
MODEL_PATH=model/artifacts/model.pkl
SCALER_PATH=model/artifacts/scaler.pkl
THRESHOLD_PATH=model/artifacts/threshold.json

# Model version metadata
MODEL_VERSION=xgb-v1.0

# Dashboard API endpoint
API_URL=http://localhost:8000
